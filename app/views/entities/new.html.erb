<div class="new-transaction-page">

  <!-- Header -->
  <div class="new-transaction-header">
    <%= link_to group_path(@group), class: "new-transaction-back" do %>
      <i class="bi bi-arrow-left"></i>
    <% end %>

    <span>New Transaction</span>
    <div></div>
  </div>

  <!-- Group information -->
  <div class="new-transaction-group">
    <div class="new-transaction-group-icon">
      <i class="bi bi-wallet2"></i>
    </div>

    <div>
      <small>Adding transaction to</small>
      <h6><%= @group.name %></h6>
    </div>
  </div>

  <!-- Form -->
  <div class="new-transaction-content">
    <div class="new-transaction-card">

      <div class="new-transaction-heading">
        <div class="new-transaction-form-icon">
          <i class="bi bi-plus-circle"></i>
        </div>

        <h3>Create a transaction</h3>
        <p>Record and keep track of your spending.</p>
      </div>

      <%= render "form", entity: @entity %>

    </div>
  </div>

</div>
