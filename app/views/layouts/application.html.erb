<!DOCTYPE html>
<html>
  <head>
    <title>BudgetApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "style.css" %>
  </head>

  <body>
    <% if notice.present? %>
      <div class="bamtee-alert bamtee-alert-success alert fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span><%= notice %></span>

        <button type="button"
                class="bamtee-alert-close"
                data-bs-dismiss="alert"
                aria-label="Close">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
    <% end %>

    <% if alert.present? %>
      <div id="bamtee-error-alert"
          class="bamtee-alert bamtee-alert-danger alert fade show"
          role="alert">

        <i class="bi bi-exclamation-circle-fill"></i>
        <span><%= alert %></span>

        <button type="button"
                class="bamtee-alert-close"
                data-bs-dismiss="alert"
                aria-label="Close">
          <i class="bi bi-x-lg"></i>
        </button>

      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
