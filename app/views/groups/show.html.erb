
<div class="transactions-page">
  <header class="transactions-header">
    <%= link_to groups_path, class: "back-button", aria: { label: "Back to categories" } do %>
      <i class="bi bi-arrow-left"></i>
    <% end %>

    <div class="header-title">
      <span>MY FINANCES</span>
      <h1>Transactions</h1>
    </div>

    <div class="header-icon">
      <i class="bi bi-wallet2"></i>
    </div>
  </header>

  <section class="category-summary">
    <div class="category-summary-info">
      <div class="category-icon">
        <i class="bi bi-folder2-open"></i>
      </div>
      <div>
        <span class="summary-label">CATEGORY</span>
        <h2><%= @group.name %></h2>
      </div>
    </div>

    <div class="category-total">
      <span class="summary-label">TOTAL SPENT</span>
      <p><%= number_to_currency(@group.entities.sum(:amount), unit: "$", precision: 2) %></p>
    </div>
  </section>

  <% if notice.present? %>
    <div class="transaction-notice" role="status">
      <i class="bi bi-check-circle-fill"></i>
      <%= notice %>
    </div>
  <% end %>

  <main class="transactions-container">
    <div class="transactions-heading">
      <div>
        <h2>Recent activity</h2>
        <p>Keep track of your spending.</p>
      </div>

      <span class="transaction-count">
        <%= @group.recent_transactions.length %>
        <%= @group.recent_transactions.length == 1 ? "transaction" : "transactions" %>
      </span>
    </div>

    <div id="entities">
      <% if @group.recent_transactions.empty? %>
        <div class="empty-transactions">
          <div class="empty-transactions-icon">
            <i class="bi bi-receipt"></i>
          </div>
          <h3>No transactions yet</h3>
          <p>Your transactions for this category will appear here.</p>

          <%= link_to new_group_entity_path(@group), class: "empty-add-link" do %>
            <i class="bi bi-plus-circle"></i>
            Add your first transaction
          <% end %>
        </div>
      <% else %>
        <% @group.recent_transactions.each do |entity| %>
          <article class="transaction-card">
            <div class="transaction-main">
              <div class="transaction-icon">
                <i class="bi bi-receipt-cutoff"></i>
              </div>

              <div class="transaction-details">
                <h3><%= entity.name %></h3>
                <p class="transaction-date">
                  <i class="bi bi-calendar3"></i>
                  <%= entity.created_at.strftime("%b %d, %Y") %>
                </p>
              </div>

              <div class="transaction-amount">
                <span>AMOUNT</span>
                <p><%= number_to_currency(entity.amount, unit: "$", precision: 2) %></p>
              </div>
            </div>

            <div class="transaction-card-footer">
              <span class="transaction-status">
                <i class="bi bi-check-circle"></i>
                Recorded
              </span>

              <%= button_to group_entity_path(@group, entity),
                  method: :delete,
                  class: "transaction-delete",
                  form: { data: { turbo_confirm: "Are you sure you want to delete this transaction?" } } do %>
                <i class="bi bi-trash3"></i>
                Delete
              <% end %>
            </div>
          </article>
        <% end %>
      <% end %>
    </div>

    <div class="transaction-actions">
      <%= link_to new_group_entity_path(@group), class: "add-transaction-btn" do %>
        <i class="bi bi-plus-circle"></i>
        Add a new transaction
      <% end %>

      <%= button_to @group,
          method: :delete,
          class: "delete-category-btn",
          form: { data: { turbo_confirm: "Are you sure you want to delete this category?" } } do %>
        <i class="bi bi-trash3"></i>
        Delete Category
      <% end %>
    </div>
  </main>
</div>
