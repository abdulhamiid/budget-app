<div id="mcv" class="category-page">
  <header class="category-header">
    <div class="category-header-inner">
      <%= link_to root_path, class: "category-menu-btn",
          aria: { label: "Go to home page" } do %>
        <i class="bi bi-list"></i>
      <% end %>

      <div class="category-heading">
        <span class="category-eyebrow">ORGANIZE YOUR CONTENT</span>
        <h1>Categories</h1>
      </div>

      <%= link_to destroy_user_session_path,
          data: { turbo_method: :delete },
          class: "category-logout-btn",
          aria: { label: "Log out" } do %>
        <i class="bi bi-box-arrow-right"></i>
      <% end %>
    </div>
  </header>

  <main class="category-main">
    <div class="category-intro">
      <div>
        <h2>Your categories</h2>
        <p>Browse and manage your categories below.</p>
      </div>

      <span class="category-count">
        <i class="bi bi-grid-fill"></i>
        <%= @groups.size %>
      </span>
    </div>

    <section id="groups" class="category-grid">
      <% @groups.each do |group| %>
        <%= link_to group, class: "category-card" do %>

          <div class="category-card-content">
            <%= render group %>
          </div>

        <% end %>
      <% end %>

      <% if @groups.empty? %>
        <div class="category-empty">
          <div class="category-empty-icon">
            <i class="bi bi-folder-plus"></i>
          </div>
          <h3>No categories yet</h3>
          <p>Create your first category to get started.</p>
        </div>
      <% end %>
    </section>

    <div class="category-add-section">
      <%= link_to new_group_path, class: "category-add-btn" do %>
        <i class="bi bi-plus-lg"></i>
        <span>Add New Category</span>
        <i class="bi bi-arrow-right category-add-arrow"></i>
      <% end %>
    </div>
  </main>

  <footer class="category-footer">
    <i class="bi bi-leaf-fill"></i>
    <span>BamTee</span>
    <span class="category-footer-dot">·</span>
    <span>Organize with ease</span>
  </footer>
</div>