
<div class="home-page">
  <div class="home-top-bar">
    <% if current_user %>
      <%= link_to groups_path, class: "home-back-btn", aria: { label: "Back to categories" } do %>
        <i class="bi bi-arrow-left"></i>
      <% end %>
    <% else %>
      <div class="home-brand">
        <i class="bi bi-wallet2"></i>
        <span>BamTee</span>
      </div>
    <% end %>
  </div>

  <main class="home-content">
    <% if current_user %>
      <div class="home-welcome-icon">
        <i class="bi bi-person-check-fill"></i>
      </div>

      <p class="home-eyebrow">YOUR FINANCES, SIMPLIFIED</p>

      <h1 class="home-title">
        Welcome back,
        <span><%= current_user.name %>!</span>
      </h1>

      <p class="home-description">
        Ready to manage your money? Keep track of your transactions
        and stay in control of your spending.
      </p>

      <div class="home-actions">
        <%= link_to groups_path, class: "home-primary-btn" do %>
          View My Categories
          <i class="bi bi-arrow-right"></i>
        <% end %>

        <%= button_to destroy_user_session_path,
            method: :delete,
            class: "home-secondary-btn" do %>
          <i class="bi bi-box-arrow-right"></i>
          Sign Out
        <% end %>
      </div>

    <% else %>
      <div class="home-hero-icon">
        <i class="bi bi-wallet2"></i>
      </div>

      <p class="home-eyebrow">SMARTER MONEY MANAGEMENT</p>

      <h1 class="home-title">
        Welcome to <span>BamTee</span>
      </h1>

      <p class="home-description">
        Take control of your finances. Organize your expenses,
        track your transactions, and make every penny count.
      </p>

      <div class="home-actions">
        <%= link_to new_user_session_path, class: "home-primary-btn" do %>
          Sign In
          <i class="bi bi-arrow-right"></i>
        <% end %>

        <%= link_to new_user_registration_path, class: "home-secondary-btn" do %>
          <i class="bi bi-person-plus"></i>
          Create an Account
        <% end %>
      </div>

      <p class="home-footer-text">
        Simple. Organized. In control.
      </p>
    <% end %>
  </main>

  <footer class="home-footer">
    <i class="bi bi-shield-check"></i>
    <span>Your journey to better money habits starts here.</span>
  </footer>
</div>
